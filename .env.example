# ============================================================================
# VARIÁVEIS DE AMBIENTE — Portal + Indicadores SME Baraúna
# Copie para ".env" e preencha. Nunca commite o ".env" de verdade.
# ============================================================================

# Postgres na Neon (https://neon.tech). Formato:
#   postgresql://usuario:senha@ep-xxxx.us-east-2.aws.neon.tech/nomedobanco?sslmode=require
# Crie um projeto Neon, copie a "Connection string" (modo "Pooled connection"
# para uso em runtime serverless da Vercel) e cole aqui.
DATABASE_URL=""

# Usada só por `prisma migrate` localmente/CI — a Neon também fornece uma
# "Direct connection" (sem pooler) recomendada para migrations. Se você não
# tiver uma URL direta separada, pode repetir o valor de DATABASE_URL.
DIRECT_URL=""

# NextAuth — gere um valor aleatório com: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# SIGEduc / Educ21 — API de dados acadêmicos da rede municipal (escolas,
# servidores, matrícula, notas, frequência). Swagger:
# https://api.educ21.com.br/swagger-ui/index.html
SIGEDUC_API_URL="https://api.educ21.com.br"
SIGEDUC_API_KEY=""
SIGEDUC_CLIENT_ID=""
